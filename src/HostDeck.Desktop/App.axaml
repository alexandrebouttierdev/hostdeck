<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmOverview="using:HostDeck.Presentation.ViewModels.Overview"
             xmlns:vmInfra="using:HostDeck.Presentation.ViewModels.Infrastructure"
             xmlns:vmHost="using:HostDeck.Presentation.ViewModels.HostDetails"
             xmlns:vmIncidents="using:HostDeck.Presentation.ViewModels.Incidents"
             xmlns:vmAlerts="using:HostDeck.Presentation.ViewModels.Alerts"
             xmlns:vmReports="using:HostDeck.Presentation.ViewModels.Reports"
             xmlns:vmTopology="using:HostDeck.Presentation.ViewModels.Topology"
             xmlns:vmLive="using:HostDeck.Presentation.ViewModels.LiveData"
             xmlns:vmDocker="using:HostDeck.Presentation.ViewModels.Docker"
             xmlns:vmSettings="using:HostDeck.Presentation.ViewModels.Settings"
             xmlns:vOverview="using:HostDeck.Presentation.Views.Overview"
             xmlns:vInfra="using:HostDeck.Presentation.Views.Infrastructure"
             xmlns:vHost="using:HostDeck.Presentation.Views.HostDetails"
             xmlns:vIncidents="using:HostDeck.Presentation.Views.Incidents"
             xmlns:vAlerts="using:HostDeck.Presentation.Views.Alerts"
             xmlns:vReports="using:HostDeck.Presentation.Views.Reports"
             xmlns:vTopology="using:HostDeck.Presentation.Views.Topology"
             xmlns:vLive="using:HostDeck.Presentation.Views.LiveData"
             xmlns:vDocker="using:HostDeck.Presentation.Views.Docker"
             xmlns:vSettings="using:HostDeck.Presentation.Views.Settings"
             x:Class="HostDeck.Desktop.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://HostDeck.Presentation/Themes/HostDeckTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vmOverview:OverviewViewModel}">
      <vOverview:OverviewView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmInfra:InfrastructureViewModel}">
      <vInfra:InfrastructureView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmHost:HostDetailsViewModel}">
      <vHost:HostDetailsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmIncidents:IncidentsViewModel}">
      <vIncidents:IncidentsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmAlerts:AlertsViewModel}">
      <vAlerts:AlertsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmReports:ReportsViewModel}">
      <vReports:ReportsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmTopology:TopologyViewModel}">
      <vTopology:TopologyView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmLive:LiveDataViewModel}">
      <vLive:LiveDataView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmDocker:DockerViewModel}">
      <vDocker:DockerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmSettings:SettingsViewModel}">
      <vSettings:SettingsView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
  </Application.Styles>

</Application>
