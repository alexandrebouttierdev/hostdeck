<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:HostDeck.Presentation.Controls"
             xmlns:charts="using:HostDeck.Presentation.Controls.Charts"
             xmlns:vm="using:HostDeck.Presentation.ViewModels.Reports"
             x:Class="HostDeck.Presentation.Views.Reports.ReportsView"
             x:DataType="vm:ReportsViewModel">
  <Grid Margin="{StaticResource ContentPadding}" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Rapports" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="Analysez la performance, la disponibilité et la fiabilité de votre infrastructure."
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
          <TextBlock Text="Période : —" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
        </Border>
        <Button Content="Exporter" IsEnabled="False" Padding="10,6"
                Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextMutedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                ToolTip.Tip="Export disponible lorsque l’historique existera." />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Tous les clusters" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Tous les environnements" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Tous les hôtes" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Tous les services" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Comparaison : période précédente" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
    </StackPanel>

    <!-- KPI densifiés (arcs vides sans inventer de %) -->
    <UniformGrid Grid.Row="2" Columns="5">
      <Border Margin="0,0,6,0" Padding="12,10" MinHeight="96"
              Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <charts:ArcGaugeControl Width="56" Height="56" Thickness="6"
                                  TrackBrush="{StaticResource BorderSubtleBrush}"
                                  Stroke="{StaticResource StatusOnlineBrush}"
                                  LabelBrush="{StaticResource TextMutedBrush}" EmptyLabel="—" Unit="%" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Disponibilité" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
            <TextBlock Text="—" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeLarge}" />
            <TextBlock Text="Sans historique" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeMicro}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Margin="3,0" Padding="12,10" MinHeight="96"
              Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <charts:ArcGaugeControl Width="56" Height="56" Thickness="6"
                                  TrackBrush="{StaticResource BorderSubtleBrush}"
                                  Stroke="{StaticResource SeverityCriticalBrush}"
                                  LabelBrush="{StaticResource TextMutedBrush}" EmptyLabel="—" Unit="%" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Indisponibilité" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
            <TextBlock Text="—" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeLarge}" />
            <TextBlock Text="0 h 0 m" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeMicro}" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Margin="3,0" Padding="12,10" MinHeight="96"
              Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Incidents" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
          <TextBlock Text="0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeLarge}" />
          <TextBlock Text="Aucun sur la période" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeMicro}" />
        </StackPanel>
      </Border>
      <Border Margin="3,0" Padding="12,10" MinHeight="96"
              Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="MTTR moyen" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
          <TextBlock Text="—" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeLarge}" />
          <TextBlock Text="Sans incidents" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeMicro}" />
        </StackPanel>
      </Border>
      <Border Margin="6,0,0,0" Padding="12,10" MinHeight="96"
              Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Hôtes impactés" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
          <TextBlock Text="0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeLarge}" />
          <TextBlock Text="sur 0 hôtes" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeMicro}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <UniformGrid Grid.Row="3" Columns="2" Rows="2">
      <Border Margin="0,0,6,6" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
        <controls:EmptyState Title="Disponibilité globale dans le temps"
                             Description="Aucune série de disponibilité tant que la flotte est vide."
                             IconData="{StaticResource IconReports}" />
      </Border>
      <Border Margin="6,0,0,6" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
        <controls:EmptyState Title="Incidents et temps d’indisponibilité"
                             Description="Les barres et courbes s’afficheront avec l’historique." />
      </Border>
      <Border Margin="0,6,6,0" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
        <controls:EmptyState Title="Tendance de capacité"
                             Description="CPU / mémoire / disque / réseau — aucune projection sans métriques."
                             IconData="{StaticResource IconLiveData}" />
      </Border>
      <Border Margin="6,6,0,0" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="14,12,14,0" Text="Top des incidents par hôte"
                     FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
          <controls:EmptyState IsCompact="True"
                               Title="Aucun classement"
                               Description="Le tableau se remplira dès qu’il y aura des incidents."
                               IconData="{StaticResource IconIncidents}" />
        </DockPanel>
      </Border>
    </UniformGrid>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Rapports prédéfinis" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" />
        <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
          <TextBlock Text="Disponibilité" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
        </Border>
        <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
          <TextBlock Text="Incidents" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
        </Border>
        <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
          <TextBlock Text="Capacité" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
        </Border>
      </StackPanel>
      <Button Grid.Column="1" Content="+ Nouveau rapport" IsEnabled="False" Padding="12,6"
              Background="{StaticResource AccentBrush}" Foreground="{StaticResource TextPrimaryBrush}"
              CornerRadius="{StaticResource RadiusSmall}" BorderThickness="0" Opacity="0.55"
              ToolTip.Tip="Création de rapports personnalisés hors périmètre V1." />
    </Grid>
  </Grid>
</UserControl>
