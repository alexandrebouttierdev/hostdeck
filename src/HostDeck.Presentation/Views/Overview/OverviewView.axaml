<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:HostDeck.Presentation.Controls"
             xmlns:charts="using:HostDeck.Presentation.Controls.Charts"
             xmlns:infra="using:HostDeck.Presentation.ViewModels.Infrastructure"
             xmlns:vm="using:HostDeck.Presentation.ViewModels.Overview"
             x:Class="HostDeck.Presentation.Views.Overview.OverviewView"
             x:DataType="vm:OverviewViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Grid Margin="{StaticResource ContentPadding}"
          RowDefinitions="Auto,Auto,Auto,*,*"
          RowSpacing="14">

      <!-- En-tête : salutation + action + état collecte -->
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="Bonjour,"
                     FontSize="{StaticResource FontSizeTitle}"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="Voici l’état de votre infrastructure en temps réel."
                     FontSize="{StaticResource FontSizeBody}"
                     Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="+ Ajouter un hôte"
                Command="{Binding AddHostCommand}"
                Padding="14,8"
                VerticalAlignment="Center"
                Background="{StaticResource AccentBrush}"
                Foreground="{StaticResource TextPrimaryBrush}"
                CornerRadius="{StaticResource RadiusSmall}"
                BorderThickness="0" />
        <Border Grid.Column="2"
                Padding="14,10"
                BorderBrush="{StaticResource StatusOnlineBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                Background="{StaticResource SurfacePanelBrush}"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="8" Height="8" Fill="{StaticResource StatusOnlineBrush}" VerticalAlignment="Center" />
            <StackPanel>
              <TextBlock Text="Collecte prête"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Text="{Binding CollectionDetailText}"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         FontSize="{StaticResource FontSizeSmall}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 4 KPI densifiés -->
      <UniformGrid Grid.Row="1" Columns="4">
        <Border Margin="0,0,8,0" Padding="{StaticResource PanelPadding}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                MinHeight="88">
          <StackPanel Spacing="6">
            <TextBlock Text="Hôtes surveillés" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
            <TextBlock Text="{Binding HostCount}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding HostsStatusSubtitle}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <Border Margin="4,0" Padding="{StaticResource PanelPadding}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                MinHeight="88">
          <StackPanel Spacing="6">
            <TextBlock Text="Incidents actifs" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
            <TextBlock Text="{Binding ActiveIncidentCount}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding IncidentsSubtitle}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <Border Margin="4,0" Padding="{StaticResource PanelPadding}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                MinHeight="88">
          <StackPanel Spacing="6">
            <TextBlock Text="Alertes ouvertes" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
            <TextBlock Text="0" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Aucune alerte" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <Border Margin="8,0,0,0" Padding="{StaticResource PanelPadding}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                MinHeight="88">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Disponibilité globale" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Text="{Binding AvailabilityText}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding AvailabilitySubtitle}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
            <charts:ArcGaugeControl Grid.Column="1"
                                    Width="{StaticResource AvailabilityGaugeSize}"
                                    Height="{StaticResource AvailabilityGaugeSize}"
                                    Thickness="5"
                                    VerticalAlignment="Center"
                                    Value="{Binding AvailabilityPercent}"
                                    TrackBrush="{StaticResource BorderSubtleBrush}"
                                    Stroke="{StaticResource StatusOnlineBrush}"
                                    LabelBrush="{StaticResource TextMutedBrush}"
                                    EmptyLabel="—"
                                    Unit="%" />
          </Grid>
        </Border>
      </UniformGrid>

      <!-- 4 jauges arcs globales (layout mockup ; empty = piste seule, pas de valeurs inventées) -->
      <UniformGrid Grid.Row="2" Columns="4">
        <Border Margin="0,0,6,0" Height="{StaticResource ArcGaugeCardHeight}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                Padding="12,10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <charts:ArcGaugeControl Width="{StaticResource ArcGaugeSize}"
                                    Height="{StaticResource ArcGaugeSize}"
                                    Thickness="{StaticResource ArcGaugeThickness}"
                                    Value="{Binding CpuGaugeValue}"
                                    TrackBrush="{StaticResource BorderSubtleBrush}"
                                    Stroke="{StaticResource SeriesCpuUserBrush}"
                                    LabelBrush="{StaticResource TextMutedBrush}"
                                    EmptyLabel="—"
                                    Unit="%" />
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="CPU global" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Text="{Binding CpuCoresText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Text="{Binding CpuAverageText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Text="{Binding CpuPeakText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Margin="3,0" Height="{StaticResource ArcGaugeCardHeight}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                Padding="12,10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <charts:ArcGaugeControl Width="{StaticResource ArcGaugeSize}"
                                    Height="{StaticResource ArcGaugeSize}"
                                    Thickness="{StaticResource ArcGaugeThickness}"
                                    Value="{Binding MemoryGaugeValue}"
                                    TrackBrush="{StaticResource BorderSubtleBrush}"
                                    Stroke="{StaticResource SeriesMemoryUsedBrush}"
                                    LabelBrush="{StaticResource TextMutedBrush}"
                                    EmptyLabel="—"
                                    Unit="%" />
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Mémoire globale" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Text="{Binding MemoryUsedText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Text="{Binding MemoryTotalText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Text="{Binding MemoryPeakText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Margin="3,0" Height="{StaticResource ArcGaugeCardHeight}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                Padding="12,10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <charts:ArcGaugeControl Width="{StaticResource ArcGaugeSize}"
                                    Height="{StaticResource ArcGaugeSize}"
                                    Thickness="{StaticResource ArcGaugeThickness}"
                                    Value="{Binding DiskGaugeValue}"
                                    TrackBrush="{StaticResource BorderSubtleBrush}"
                                    Stroke="{StaticResource SeriesDiskBrush}"
                                    LabelBrush="{StaticResource TextMutedBrush}"
                                    EmptyLabel="—"
                                    Unit="%" />
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Stockage global" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Text="{Binding DiskUsedText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Text="{Binding DiskTotalText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Text="{Binding DiskPeakText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
            </StackPanel>
          </Grid>
        </Border>
        <Border Margin="6,0,0,0" Height="{StaticResource ArcGaugeCardHeight}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                Padding="12,10">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <charts:ArcGaugeControl Width="{StaticResource ArcGaugeSize}"
                                    Height="{StaticResource ArcGaugeSize}"
                                    Thickness="{StaticResource ArcGaugeThickness}"
                                    Value="{Binding NetworkGaugeValue}"
                                    TrackBrush="{StaticResource BorderSubtleBrush}"
                                    Stroke="{StaticResource SeriesNetworkInBrush}"
                                    LabelBrush="{StaticResource TextMutedBrush}"
                                    EmptyLabel="—"
                                    Unit="%" />
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="Réseau global" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Text="{Binding NetworkInText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Text="{Binding NetworkOutText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Text="{Binding NetworkPeakText}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
            </StackPanel>
          </Grid>
        </Border>
      </UniformGrid>

      <!-- Graphiques + hôtes sollicités (3 colonnes comme la maquette) -->
      <Grid Grid.Row="3" ColumnDefinitions="*,*,0.85*" ColumnSpacing="12" MinHeight="200">
        <charts:ChartFrame Title="Utilisation CPU globale"
                           Series="{Binding CpuSeries}"
                           YAxisMax="100"
                             Stacked="True"
                           EmptyTitle="Aucune série disponible"
                           EmptyDescription="Les graphiques s’afficheront dès que des métriques seront collectées."
                           EmptyIconData="{StaticResource IconLiveData}" />
        <charts:ChartFrame Grid.Column="1"
                           Title="Utilisation mémoire globale"
                           Series="{Binding MemorySeries}"
                           YAxisMax="100"
                           EmptyTitle="Aucune série disponible"
                           EmptyDescription="Les graphiques s’afficheront dès que des métriques seront collectées." />
        <Border Grid.Column="2"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="14,12,14,0" Text="Hôtes les plus sollicités"
                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
            <Panel>
              <controls:EmptyState IsVisible="{Binding IsEmpty}"
                                   IsCompact="True"
                                   Title="Aucune flotte configurée"
                                   Description="Ajoutez un serveur Linux pour alimenter ce classement."
                                   IconData="{StaticResource IconInfrastructure}" />
              <DataGrid IsVisible="{Binding !IsEmpty}"
                        ItemsSource="{Binding TopHosts}"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="False"
                        CanUserSortColumns="False"
                        GridLinesVisibility="Horizontal"
                        BorderThickness="0"
                        Background="Transparent"
                        RowHeight="{StaticResource TableRowHeight}"
                        HeadersVisibility="Column"
                        Margin="8,4,8,8">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Hôte" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="52" />
                  <DataGridTextColumn Header="Mémoire" Binding="{Binding MemoryText}" Width="64" />
                  <DataGridTemplateColumn Header="Réseau" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="infra:HostListItemViewModel">
                        <charts:SparklineControl Width="56" Height="18"
                                                 Values="{Binding NetworkSeries}"
                                                 Stroke="{StaticResource SeriesNetworkInBrush}"
                                                 EmptyStroke="{StaticResource BorderSubtleBrush}"
                                                 VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Incidents récents + état des services -->
      <Grid Grid.Row="4" ColumnDefinitions="1.6*,*" ColumnSpacing="12" MinHeight="170">
        <Border Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="14,12,14,0" Text="Incidents récents"
                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
            <controls:EmptyState Title="Aucun incident actif"
                                 Description="Les incidents apparaîtront ici lorsque des règles d’alerte se déclencheront."
                                 IconData="{StaticResource IconIncidents}" />
          </DockPanel>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="14,12,14,0" Text="État des services"
                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
            <StackPanel Margin="14,10,14,14" Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Collecte des métriques" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource StatusOnlineBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Opérationnel" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Base de données locale" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource StatusOnlineBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Opérationnel" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Agents" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
                <TextBlock Grid.Column="1" Text="Hors périmètre V1" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Notifications externes" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
                <TextBlock Grid.Column="1" Text="Hors périmètre V1" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              </Grid>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
