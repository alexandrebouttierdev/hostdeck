<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:HostDeck.Presentation.Controls"
             xmlns:charts="using:HostDeck.Presentation.Controls.Charts"
             xmlns:infra="using:HostDeck.Presentation.ViewModels.Infrastructure"
             xmlns:vm="using:HostDeck.Presentation.ViewModels.Overview"
             x:Class="HostDeck.Presentation.Views.Overview.OverviewView"
             x:DataType="vm:OverviewViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Grid Margin="{StaticResource ContentPadding}" RowDefinitions="Auto,Auto,*" RowSpacing="16">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="Bonjour,"
                     FontSize="{StaticResource FontSizeTitle}"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="Voici l’état de votre infrastructure en temps réel."
                     FontSize="{StaticResource FontSizeBody}"
                     Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
        <Border Grid.Column="1"
                Padding="14,10"
                BorderBrush="{StaticResource StatusOnlineBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                Background="{StaticResource SurfacePanelBrush}"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="8" Height="8" Fill="{StaticResource StatusOnlineBrush}" VerticalAlignment="Center" />
            <StackPanel>
              <TextBlock Text="Collecte prête"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Text="En attente du premier hôte."
                         Foreground="{StaticResource TextSecondaryBrush}"
                         FontSize="{StaticResource FontSizeSmall}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <UniformGrid Grid.Row="1" Columns="4">
        <Border Margin="0,0,8,0" Padding="{StaticResource PanelPadding}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                MinHeight="96">
          <StackPanel Spacing="6">
            <TextBlock Text="Hôtes surveillés" Classes="secondary" />
            <TextBlock Text="{Binding HostCount}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="0 opérationnel · 0 avertissement · 0 problème" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <Border Margin="4,0" Padding="{StaticResource PanelPadding}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                MinHeight="96">
          <StackPanel Spacing="6">
            <TextBlock Text="Incidents actifs" Classes="secondary" />
            <TextBlock Text="{Binding ActiveIncidentCount}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Aucun incident ouvert" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <Border Margin="4,0" Padding="{StaticResource PanelPadding}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                MinHeight="96">
          <StackPanel Spacing="6">
            <TextBlock Text="Alertes ouvertes" Classes="secondary" />
            <TextBlock Text="0" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Aucune alerte" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
        </Border>
        <Border Margin="8,0,0,0" Padding="{StaticResource PanelPadding}"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                MinHeight="96">
          <StackPanel Spacing="6">
            <TextBlock Text="Disponibilité globale" Classes="secondary" />
            <TextBlock Text="—" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Indisponible sans flotte" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Grid Grid.Row="2" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,*" RowSpacing="12" ColumnSpacing="12">
        <UniformGrid Grid.ColumnSpan="2" Columns="4">
          <Border Margin="0,0,6,0" Height="120" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
            <controls:EmptyState Title="CPU global" Description="Aucune métrique collectée." IconData="{StaticResource IconLiveData}" />
          </Border>
          <Border Margin="3,0" Height="120" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
            <controls:EmptyState Title="Mémoire globale" Description="Aucune métrique collectée." />
          </Border>
          <Border Margin="3,0" Height="120" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
            <controls:EmptyState Title="Stockage global" Description="Aucune métrique collectée." />
          </Border>
          <Border Margin="6,0,0,0" Height="120" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
            <controls:EmptyState Title="Réseau global" Description="Aucune métrique collectée." />
          </Border>
        </UniformGrid>

        <charts:ChartFrame Grid.Row="1"
                           MinHeight="180"
                           Title="Utilisation CPU globale"
                           Series="{Binding CpuSeries}"
                           EmptyTitle="Aucune série disponible"
                           EmptyDescription="Les graphiques s’afficheront dès que des métriques seront collectées."
                           EmptyIconData="{StaticResource IconLiveData}" />

        <charts:ChartFrame Grid.Row="1" Grid.Column="1"
                           MinHeight="180"
                           Title="Utilisation mémoire globale"
                           Series="{Binding MemorySeries}"
                           EmptyTitle="Aucune série disponible"
                           EmptyDescription="Les graphiques s’afficheront dès que des métriques seront collectées." />

        <Border Grid.Row="2" MinHeight="160"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="14,12,14,0" Text="Incidents récents"
                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <controls:EmptyState Title="Aucun incident actif"
                                 Description="Les incidents apparaîtront ici lorsque des règles d’alerte se déclencheront."
                                 IconData="{StaticResource IconIncidents}" />
          </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" MinHeight="160"
                Background="{StaticResource SurfacePanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="14,12,14,0" Text="Hôtes les plus sollicités"
                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <Panel>
              <controls:EmptyState IsVisible="{Binding IsEmpty}"
                                   Title="Aucune flotte configurée"
                                   Description="Ajoutez votre premier serveur Linux pour alimenter la vue d’ensemble."
                                   IconData="{StaticResource IconInfrastructure}" />
              <DataGrid IsVisible="{Binding !IsEmpty}"
                        ItemsSource="{Binding TopHosts}"
                        AutoGenerateColumns="False"
                        CanUserResizeColumns="False"
                        CanUserSortColumns="False"
                        GridLinesVisibility="Horizontal"
                        BorderThickness="0"
                        Background="Transparent"
                        RowHeight="{StaticResource TableRowHeight}"
                        HeadersVisibility="Column"
                        Margin="8,4,8,8">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Hôte" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="56" />
                  <DataGridTextColumn Header="Mémoire" Binding="{Binding MemoryText}" Width="70" />
                  <DataGridTemplateColumn Header="Réseau" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="infra:HostListItemViewModel">
                        <charts:SparklineControl Width="56" Height="18"
                                                 Values="{Binding NetworkSeries}"
                                                 Stroke="{StaticResource SeriesNetworkInBrush}"
                                                 EmptyStroke="{StaticResource BorderSubtleBrush}"
                                                 VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
