<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:HostDeck.Presentation.Controls"
             xmlns:vm="using:HostDeck.Presentation.ViewModels.Alerts"
             x:Class="HostDeck.Presentation.Views.Alerts.AlertsView"
             x:DataType="vm:AlertsViewModel">

  <Grid Margin="{StaticResource ContentPadding}" RowDefinitions="Auto,*" RowSpacing="12">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Règles d’alerte" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="Surveillez votre infrastructure et soyez notifié en cas d’anomalie."
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="+ Nouvelle règle"
              Command="{Binding StartCreateCommand}"
              Padding="14,8"
              VerticalAlignment="Center"
              Background="{StaticResource AccentBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              CornerRadius="{StaticResource RadiusSmall}"
              BorderThickness="0"
              ToolTip.Tip="Créer une nouvelle règle d’alerte." />
    </Grid>

    <!-- Split liste + éditeur (maquette 05) -->
    <Grid Grid.Row="1" ColumnDefinitions="1.2*,12,*">
      <Border Background="{StaticResource SurfacePanelBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}"
              CornerRadius="{StaticResource RadiusSmall}">
        <Panel>
          <controls:EmptyState IsVisible="{Binding IsEmpty}"
                               Title="Aucune règle d’alerte"
                               Description="Créez une règle pour surveiller CPU, mémoire, disque ou charge."
                               IconData="{StaticResource IconAlerts}" />
          <DataGrid IsVisible="{Binding !IsEmpty}"
                    ItemsSource="{Binding Rules}"
                    SelectedItem="{Binding SelectedRule}"
                    AutoGenerateColumns="False"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent"
                    RowHeight="{StaticResource TableRowHeight}">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Activée" Binding="{Binding IsEnabled}" Width="80" IsReadOnly="True" />
              <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Métrique" Binding="{Binding Metric}" Width="120" />
              <DataGridTextColumn Header="Sévérité" Binding="{Binding Severity}" Width="110" />
              <DataGridTextColumn Header="Incidents" Binding="{Binding ActiveIncidents}" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
        </Panel>
      </Border>

      <Border Grid.Column="2"
              Background="{StaticResource SurfacePanelBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}"
              CornerRadius="{StaticResource RadiusSmall}">
        <DockPanel Margin="{StaticResource PanelPadding}">
          <TextBlock DockPanel.Dock="Top" Text="Éditeur de règle"
                     FontWeight="SemiBold" FontSize="{StaticResource FontSizeLarge}"
                     Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
          <Border DockPanel.Dock="Bottom" Margin="0,12,0,0"
                  Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusSmall}" MinHeight="80" Padding="10">
            <TextBlock Text="Canaux de notification — hors périmètre V1"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}"
                       VerticalAlignment="Center" />
          </Border>

          <Panel>
            <controls:EmptyState IsVisible="{Binding !IsEditorVisible}"
                                 IsCompact="True"
                                 Title="Formulaire en attente"
                                 Description="Sélectionnez une règle ou créez-en une nouvelle pour l’éditer."
                                 IconData="{StaticResource IconAlerts}" />

            <ScrollViewer IsVisible="{Binding IsEditorVisible}">
              <StackPanel Spacing="10">
                <TextBlock Text="Nom" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
                <TextBox Text="{Binding EditorName}" PlaceholderText="Nom de la règle" />

                <TextBlock Text="Description" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
                <TextBox Text="{Binding EditorDescription}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" />

                <TextBlock Text="Métrique" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
                <ComboBox ItemsSource="{Binding MetricOptions}"
                          SelectedItem="{Binding EditorMetric}"
                          IsEnabled="{Binding !IsMetricReadOnly}" />

                <TextBlock Text="Sévérité" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
                <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding EditorSeverity}" />

                <TextBlock Text="Comparaison" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
                <ComboBox ItemsSource="{Binding ComparisonOptions}" SelectedItem="{Binding EditorComparison}" />

                <TextBlock Text="Seuil" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
                <NumericUpDown Value="{Binding EditorThresholdValue}" Minimum="0" Maximum="10000" FormatString="0.##" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Durée (min)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
                    <NumericUpDown Value="{Binding EditorDurationMinutes}" Minimum="1" Maximum="1440" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Cooldown (min)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
                    <NumericUpDown Value="{Binding EditorCooldownMinutes}" Minimum="1" Maximum="1440" />
                  </StackPanel>
                </Grid>

                <CheckBox Content="Règle activée" IsChecked="{Binding EditorIsEnabled}" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                  <Button Content="Enregistrer"
                          Command="{Binding SaveCommand}"
                          Padding="12,8"
                          Background="{StaticResource AccentBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="0"
                          CornerRadius="{StaticResource RadiusSmall}" />
                  <Button Content="Supprimer"
                          Command="{Binding DeleteCommand}"
                          IsEnabled="{Binding CanDelete}"
                          Padding="12,8"
                          Background="{StaticResource SurfaceRaisedBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderSubtleBrush}"
                          CornerRadius="{StaticResource RadiusSmall}" />
                  <Button Content="Annuler"
                          Command="{Binding CancelEditCommand}"
                          Padding="12,8"
                          Background="{StaticResource SurfaceRaisedBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderSubtleBrush}"
                          CornerRadius="{StaticResource RadiusSmall}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
