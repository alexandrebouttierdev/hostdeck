<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:HostDeck.Presentation.Controls"
             xmlns:charts="using:HostDeck.Presentation.Controls.Charts"
             xmlns:vm="using:HostDeck.Presentation.ViewModels.LiveData"
             xmlns:infra="using:HostDeck.Presentation.ViewModels.Infrastructure"
             x:Class="HostDeck.Presentation.Views.LiveData.LiveDataView"
             x:DataType="vm:LiveDataViewModel">
  <Grid Margin="{StaticResource ContentPadding}" RowDefinitions="Auto,Auto,*" RowSpacing="10">

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="Données en direct" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="Métriques temps réel, min / moy / max — sans inventer de valeurs." Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
          <TextBlock Text="Dernières 2 heures" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
        </Border>
        <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
          <TextBlock Text="Intervalle : —" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
        </Border>
        <Button Content="Ouvrir un terminal" IsEnabled="False" Padding="10,6"
                Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextMutedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                ToolTip.Tip="Hors périmètre V1." />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
      <Border Background="{StaticResource SelectionBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Métriques" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Système" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Disque" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Réseau" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Processus" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}"
                   ToolTip.Tip="Liste processus hors périmètre V1." />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Services" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Journaux" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="200,*,Auto" ColumnSpacing="0">
      <Border Background="{StaticResource SurfacePanelBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}"
              CornerRadius="{StaticResource RadiusSmall}"
              Margin="0,0,10,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="12,10,12,4" Text="Sources"
                     FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
          <Panel>
            <controls:EmptyState IsVisible="{Binding IsEmpty}"
                                 IsCompact="True"
                                 Title="Aucun hôte"
                                 Description="La liste des sources apparaîtra avec la flotte."
                                 IconData="{StaticResource IconInfrastructure}" />
            <ListBox IsVisible="{Binding !IsEmpty}"
                     ItemsSource="{Binding Hosts}"
                     SelectedItem="{Binding SelectedHost}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="infra:HostListItemViewModel">
                  <StackPanel Spacing="2" Margin="8,6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Address}" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
        <StackPanel Spacing="10">
          <charts:ChartFrame MinHeight="150"
                             Title="Utilisation CPU"
                             Series="{Binding CpuSeries}"
                             EmptyTitle="Aucune donnée en direct"
                             EmptyDescription="Sélectionnez un hôte pour afficher les métriques en temps réel."
                             EmptyIconData="{StaticResource IconLiveData}" />
          <charts:ChartFrame MinHeight="150"
                             Title="Utilisation mémoire"
                             Series="{Binding MemorySeries}"
                             EmptyTitle="Aucune série disponible"
                             EmptyDescription="En attente de collecte." />
          <charts:ChartFrame MinHeight="140"
                             Title="E/S disque"
                             Series="{Binding DiskSeries}"
                             EmptyTitle="Aucune série disponible"
                             EmptyDescription="En attente de collecte." />
          <charts:ChartFrame MinHeight="140"
                             Title="Trafic réseau"
                             Series="{Binding NetworkSeries}"
                             EmptyTitle="Aucune série disponible"
                             EmptyDescription="En attente de collecte." />
          <charts:ChartFrame MinHeight="140"
                             Title="Charge système"
                             Series="{Binding LoadSeries}"
                             EmptyTitle="Aucune série disponible"
                             EmptyDescription="En attente de collecte." />
        </StackPanel>
      </ScrollViewer>

      <!-- Panneau détail : structure maquette 08 ; visible dès qu'un hôte est sélectionné. -->
      <Border Grid.Column="2"
              IsVisible="{Binding HasSelection}"
              Width="{StaticResource DetailPanelDefaultWidth}"
              MinWidth="{StaticResource DetailPanelMinWidth}"
              MaxWidth="{StaticResource DetailPanelMaxWidth}"
              Background="{StaticResource SurfacePanelBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}"
              CornerRadius="{StaticResource RadiusSmall}">
        <ScrollViewer>
          <StackPanel Margin="{StaticResource PanelPadding}" Spacing="12">
            <TextBlock Text="Informations sur l’hôte" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
              <TextBlock Text="Nom" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Grid.Column="1" Text="{Binding SelectedHost.Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Grid.Row="1" Text="Adresse" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedHost.Address}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Grid.Row="2" Text="Système" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedHost.OperatingSystem}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Grid.Row="3" Text="État" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedHost.Status}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Grid.Row="4" Text="Environnement" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Grid.Row="5" Text="Groupe" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
            </Grid>

            <TextBlock Text="Valeurs instantanées" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="CPU" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" /><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" /></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Mémoire" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" /><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" /></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Disque R/W" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" /><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" /></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Réseau E/S" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" /><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" /></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Load 1m" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" /><TextBlock Grid.Column="1" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" /></Grid>
            </StackPanel>

            <TextBlock Text="Liens rapides" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <StackPanel Spacing="4">
              <TextBlock Text="Terminal" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" ToolTip.Tip="Hors périmètre V1." />
              <TextBlock Text="Processus" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Text="Services" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Text="Journaux" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Text="Configurer une alerte" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
