<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:HostDeck.Presentation.Controls"
             xmlns:vm="using:HostDeck.Presentation.ViewModels.Incidents"
             x:Class="HostDeck.Presentation.Views.Incidents.IncidentsView"
             x:DataType="vm:IncidentsViewModel">

  <Grid Margin="{StaticResource ContentPadding}" RowDefinitions="Auto,*" RowSpacing="12">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="44" Height="44" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusMedium}">
          <Path Data="{StaticResource IconIncidents}" Stretch="Uniform" Width="22" Height="22"
                StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                Stroke="{StaticResource SeverityCriticalBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Spacing="2">
          <TextBlock Text="Incidents actifs" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="Diagnostiquez et traitez les anomalies détectées sur la flotte."
                     Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Padding="10,6" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
          <TextBlock Foreground="{StaticResource SeverityCriticalBrush}" FontSize="{StaticResource FontSizeBody}">
            <Run Text="Critiques " />
            <Run Text="{Binding CriticalCount}" FontWeight="SemiBold" />
          </TextBlock>
        </Border>
        <Border Padding="10,6" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
          <TextBlock Foreground="{StaticResource SeverityHighBrush}" FontSize="{StaticResource FontSizeBody}">
            <Run Text="Majeurs " />
            <Run Text="{Binding HighCount}" FontWeight="SemiBold" />
          </TextBlock>
        </Border>
        <Border Padding="10,6" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}">
          <TextBlock Foreground="{StaticResource SeverityWarningBrush}" FontSize="{StaticResource FontSizeBody}">
            <Run Text="Avertissements " />
            <Run Text="{Binding WarningCount}" FontWeight="SemiBold" />
          </TextBlock>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Split liste + panneau diagnostic (maquette 04) -->
    <Grid Grid.Row="1" ColumnDefinitions="1.35*,12,*">
      <Border Background="{StaticResource SurfacePanelBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}"
              CornerRadius="{StaticResource RadiusSmall}">
        <Panel>
          <controls:EmptyState IsVisible="{Binding IsEmpty}"
                               Title="Aucun incident actif"
                               Description="Les incidents apparaîtront ici lorsque des règles d’alerte se déclencheront."
                               IconData="{StaticResource IconIncidents}" />
          <DataGrid IsVisible="{Binding !IsEmpty}"
                    ItemsSource="{Binding Incidents}"
                    SelectedItem="{Binding SelectedIncident}"
                    AutoGenerateColumns="False"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent"
                    RowHeight="{StaticResource TableRowHeight}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Sévérité" Binding="{Binding Severity}" Width="100" />
              <DataGridTextColumn Header="Hôte" Binding="{Binding ServerName}" Width="140" />
              <DataGridTextColumn Header="Problème" Binding="{Binding Problem}" Width="*" />
              <DataGridTextColumn Header="État" Binding="{Binding Status}" Width="120" />
              <DataGridTextColumn Header="Durée" Binding="{Binding Duration}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
        </Panel>
      </Border>

      <Border Grid.Column="2"
              Background="{StaticResource SurfacePanelBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}"
              CornerRadius="{StaticResource RadiusSmall}">
        <DockPanel Margin="{StaticResource PanelPadding}">
          <TextBlock DockPanel.Dock="Top" Text="Diagnostic"
                     FontWeight="SemiBold" FontSize="{StaticResource FontSizeLarge}"
                     Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <Button Content="Acquitter"
                    Command="{Binding AcknowledgeCommand}"
                    IsEnabled="{Binding CanAcknowledge}"
                    HorizontalAlignment="Stretch" Padding="10,8"
                    Background="{StaticResource AccentBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderThickness="0" CornerRadius="{StaticResource RadiusSmall}" />
            <Button Content="Résoudre"
                    Command="{Binding ResolveCommand}"
                    IsEnabled="{Binding CanResolve}"
                    HorizontalAlignment="Stretch" Padding="10,8"
                    Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="{StaticResource RadiusSmall}" />
          </StackPanel>
          <Grid RowDefinitions="*,*" RowSpacing="10">
            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusSmall}">
              <Panel>
                <controls:EmptyState IsVisible="{Binding !HasSelection}"
                                     IsCompact="True"
                                     Title="Chronologie"
                                     Description="Sélectionnez un incident pour afficher sa chronologie." />
                <ScrollViewer IsVisible="{Binding HasSelection}" Padding="10">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Chronologie" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Timeline}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IncidentTimelineItemViewModel">
                          <Border Padding="0,4" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                              <TextBlock Text="{Binding TimeText}"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         FontSize="{StaticResource FontSizeSmall}" />
                              <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="{StaticResource FontSizeBody}" />
                                <TextBlock Text="{Binding Detail}"
                                           IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Panel>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusSmall}">
              <Panel Margin="10">
                <controls:EmptyState IsVisible="{Binding !HasSelection}"
                                     IsCompact="True"
                                     Title="Contexte métrique"
                                     Description="Sélectionnez un incident pour afficher le contexte de la règle."
                                     IconData="{StaticResource IconLiveData}" />
                <StackPanel IsVisible="{Binding HasSelection}" Spacing="6">
                  <TextBlock Text="Contexte de la règle" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding SelectedRuleName}" Foreground="{StaticResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding SelectedRuleDescription}"
                             IsVisible="{Binding SelectedRuleDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             FontSize="{StaticResource FontSizeSmall}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="Le graphique de contexte sera alimenté par la collecte."
                             Foreground="{StaticResource TextMutedBrush}"
                             FontSize="{StaticResource FontSizeSmall}" />
                </StackPanel>
              </Panel>
            </Border>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
