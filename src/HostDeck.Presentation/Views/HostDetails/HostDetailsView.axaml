<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:HostDeck.Presentation.Controls"
             xmlns:charts="using:HostDeck.Presentation.Controls.Charts"
             xmlns:vm="using:HostDeck.Presentation.ViewModels.HostDetails"
             x:Class="HostDeck.Presentation.Views.HostDetails.HostDetailsView"
             x:DataType="vm:HostDetailsViewModel">

  <Grid Margin="{StaticResource ContentPadding}" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

    <!-- En-tête hôte (structure maquette 03) -->
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
      <Border Width="44" Height="44"
              Background="{StaticResource SurfaceRaisedBrush}"
              CornerRadius="{StaticResource RadiusMedium}">
        <Path Data="{StaticResource IconInfrastructure}"
              Stretch="Uniform" Width="22" Height="22"
              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
              Stroke="{StaticResource AccentHoverBrush}"
              HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding DisplayName}"
                     FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}" />
          <Border Padding="8,2" Background="{StaticResource SurfaceRaisedBrush}"
                  BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}"
                  CornerRadius="{StaticResource RadiusPill}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="{StaticResource StatusUnknownBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DisplayStatus}"
                         FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Text="{Binding DisplayAddress, StringFormat='IP : {0}'}"
                     FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
          <TextBlock Text="{Binding DisplayOperatingSystem, StringFormat='OS : {0}'}"
                     FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
          <TextBlock Text="Environnement : —" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
          <TextBlock Text="Rôle : —" FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Ouvrir dans une vue" IsEnabled="False" Padding="10,6"
                Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextMutedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                ToolTip.Tip="Disponible lorsque des vues sauvegardées seront supportées." />
        <Button Content="Exécuter une commande" IsEnabled="False" Padding="10,6"
                Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextMutedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}"
                ToolTip.Tip="Hors périmètre V1." />
        <Button Content="Plus d’actions" IsEnabled="False" Padding="10,6"
                Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextMutedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusSmall}" />
      </StackPanel>
    </Grid>

    <!-- Onglets (structure fidèle ; pas de fake data) -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
      <Border Background="{StaticResource SelectionBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Vue d’ensemble" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Métriques" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Incidents 0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Services" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}"
                   ToolTip.Tip="Inventaire services hors périmètre V1." />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Système" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
      <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,6">
        <TextBlock Text="Configuration" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeBody}" />
      </Border>
    </StackPanel>

    <!-- Corps : graphiques + panneau info (maquette 03) -->
    <Grid Grid.Row="2" ColumnDefinitions="*,280" ColumnSpacing="10" MinHeight="280">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <UniformGrid Columns="2" Rows="3">
          <charts:ChartFrame Margin="0,0,6,6" MinHeight="140"
                             Title="Utilisation CPU"
                             Series="{Binding CpuSeries}"
                             EmptyTitle="Aucune série disponible"
                             EmptyDescription="En attente de collecte."
                             EmptyIconData="{StaticResource IconLiveData}" />
          <charts:ChartFrame Margin="6,0,0,6" MinHeight="140"
                             Title="Utilisation mémoire"
                             Series="{Binding MemorySeries}"
                             EmptyTitle="Aucune série disponible"
                             EmptyDescription="En attente de collecte." />
          <charts:ChartFrame Margin="0,6,6,6" MinHeight="140"
                             Title="Trafic réseau"
                             Series="{Binding NetworkSeries}"
                             EmptyTitle="Aucune série disponible"
                             EmptyDescription="En attente de collecte." />
          <charts:ChartFrame Margin="6,6,0,6" MinHeight="140"
                             Title="E/S disque"
                             Series="{Binding DiskSeries}"
                             EmptyTitle="Aucune série disponible"
                             EmptyDescription="En attente de collecte." />
          <Border Margin="0,6,6,0" MinHeight="120"
                  Background="{StaticResource SurfacePanelBrush}"
                  BorderBrush="{StaticResource BorderSubtleBrush}"
                  BorderThickness="{StaticResource BorderThin}"
                  CornerRadius="{StaticResource RadiusSmall}">
            <controls:EmptyState IsCompact="True"
                                 Title="Load average"
                                 Description="Séries 1m / 5m / 15m dès la collecte."
                                 IconData="{StaticResource IconLiveData}" />
          </Border>
          <Border Margin="6,6,0,0" MinHeight="120"
                  Background="{StaticResource SurfacePanelBrush}"
                  BorderBrush="{StaticResource BorderSubtleBrush}"
                  BorderThickness="{StaticResource BorderThin}"
                  CornerRadius="{StaticResource RadiusSmall}">
            <controls:EmptyState IsCompact="True"
                                 Title="Requêtes base de données"
                                 Description="Hors périmètre V1 — panneau conservé."
                                 IconData="{StaticResource IconReports}" />
          </Border>
        </UniformGrid>
      </ScrollViewer>

      <Border Grid.Column="1"
              Background="{StaticResource SurfacePanelBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}"
              CornerRadius="{StaticResource RadiusSmall}">
        <ScrollViewer>
          <StackPanel Margin="{StaticResource PanelPadding}" Spacing="12">
            <TextBlock Text="Informations de l’hôte" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
              <TextBlock Text="Nom" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Grid.Column="1" Text="{Binding HostNameOrDash}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Grid.Row="1" Text="Adresse" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayAddress}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Grid.Row="2" Text="État" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Grid.Row="3" Text="Système" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DisplayOperatingSystem}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
              <TextBlock Grid.Row="4" Text="Uptime" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeBody}" />
            </Grid>

            <TextBlock Text="Tags" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Aucun tag" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />

            <TextBlock Text="État des services" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <controls:EmptyState IsCompact="True"
                                 Title="Inventaire non collecté"
                                 Description="Hors périmètre V1."
                                 IconData="{StaticResource IconDocker}" />

            <TextBlock Text="Incidents récents" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Aucun incident sur cet hôte." Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Bas : services + incidents (empty intentionnels) -->
    <Grid Grid.Row="3" ColumnDefinitions="1.4*,*" ColumnSpacing="10" MinHeight="120">
      <Border Background="{StaticResource SurfacePanelBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}"
              CornerRadius="{StaticResource RadiusSmall}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="14,10,14,0" Text="Services sur cet hôte"
                     FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
          <controls:EmptyState IsCompact="True"
                               Title="Services — hors périmètre V1"
                               Description="L’inventaire des services par hôte n’est pas collecté dans cette version."
                               IconData="{StaticResource IconDocker}" />
        </DockPanel>
      </Border>
      <Border Grid.Column="1"
              Background="{StaticResource SurfacePanelBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="{StaticResource BorderThin}"
              CornerRadius="{StaticResource RadiusSmall}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="14,10,14,0" Text="Incidents récents sur cet hôte"
                     FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeBody}" />
          <controls:EmptyState IsCompact="True"
                               Title="Aucun incident"
                               Description="Les incidents liés à cet hôte apparaîtront ici."
                               IconData="{StaticResource IconIncidents}" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
