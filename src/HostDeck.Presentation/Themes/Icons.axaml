<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Icônes HostDeck, en géométries vectorielles sur une grille de 24x24.

    Des tracés plutôt que des glyphes Unicode : un glyphe dépend de la police installée,
    rend une taille et une graisse qu'on ne contrôle pas, et retombe sur un caractère de
    remplacement quand la police ne le couvre pas. Un tracé rend de façon identique sur
    Windows, macOS et Linux, et se met à l'échelle proprement en HiDPI (§35).
  -->

  <!-- Vue d'ensemble : quatre tuiles -->
  <StreamGeometry x:Key="IconOverview">
    M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z
  </StreamGeometry>

  <!-- Infrastructure : deux baies empilées -->
  <StreamGeometry x:Key="IconInfrastructure">
    M3,4 H21 V10 H3 Z M3,14 H21 V20 H3 Z M6,7 H8 M6,17 H8 M17,7 H18 M17,17 H18
  </StreamGeometry>

  <!-- Incidents : triangle d'alerte -->
  <StreamGeometry x:Key="IconIncidents">
    M12,3 L22,20 H2 Z M12,9 V14 M12,16.5 V17.5
  </StreamGeometry>

  <!-- Données en direct : courbe de série temporelle -->
  <StreamGeometry x:Key="IconLiveData">
    M3,16 L7,10 L11,14 L15,6 L18,11 L21,8
  </StreamGeometry>

  <!-- Docker : conteneurs empilés -->
  <StreamGeometry x:Key="IconDocker">
    M4,11 H8 V15 H4 Z M9.5,11 H13.5 V15 H9.5 Z M15,11 H19 V15 H15 Z M9.5,6.5 H13.5 V10 H9.5 Z
    M3,17 H21
  </StreamGeometry>

  <!-- Alertes : cloche -->
  <StreamGeometry x:Key="IconAlerts">
    M12,3 C15.3,3 17,5.2 17,8.5 V13 L19,16 H5 L7,13 V8.5 C7,5.2 8.7,3 12,3 Z M10,18.5 H14
  </StreamGeometry>

  <!-- Rapports : document avec barres -->
  <StreamGeometry x:Key="IconReports">
    M5,3 H15 L19,7 V21 H5 Z M15,3 V7 H19 M8,12 V17 M11.5,10 V17 M15,14 V17
  </StreamGeometry>

  <!-- Topologie : nœuds reliés -->
  <StreamGeometry x:Key="IconTopology">
    M12,3 A2.2,2.2 0 1,1 12,7.4 A2.2,2.2 0 1,1 12,3 Z
    M5,16.6 A2.2,2.2 0 1,1 5,21 A2.2,2.2 0 1,1 5,16.6 Z
    M19,16.6 A2.2,2.2 0 1,1 19,21 A2.2,2.2 0 1,1 19,16.6 Z
    M12,7.4 V12 M12,12 H5 V16.6 M12,12 H19 V16.6
  </StreamGeometry>

  <!--
    Paramètres : engrenage.

    Contour complet plutôt qu'un cercle entouré de traits radiaux : à 22 px, des rayons
    détachés se lisent comme un soleil, pas comme un engrenage.
  -->
  <StreamGeometry x:Key="IconSettings">
    M10.7,2.6 H13.3 L13.8,5.1 L15.7,5.9 L17.8,4.6 L19.6,6.4 L18.3,8.5 L19.1,10.4 L21.6,10.9
    V13.5 L19.1,14 L18.3,15.9 L19.6,18 L17.8,19.8 L15.7,18.5 L13.8,19.3 L13.3,21.8 H10.7
    L10.2,19.3 L8.3,18.5 L6.2,19.8 L4.4,18 L5.7,15.9 L4.9,14 L2.4,13.5 V10.9 L4.9,10.4
    L5.7,8.5 L4.4,6.4 L6.2,4.6 L8.3,5.9 L10.2,5.1 Z
    M12,9 A3.2,3.2 0 1,1 12,15.4 A3.2,3.2 0 1,1 12,9 Z
  </StreamGeometry>

  <!-- Aide -->
  <StreamGeometry x:Key="IconHelp">
    M12,3 A9,9 0 1,1 12,21 A9,9 0 1,1 12,3 Z
    M9.3,9.2 C9.3,7.5 10.5,6.6 12,6.6 C13.6,6.6 14.7,7.6 14.7,9 C14.7,11.2 12,11.3 12,13.6
    M12,16.8 V17.6
  </StreamGeometry>

  <!-- Recherche -->
  <StreamGeometry x:Key="IconSearch">
    M10.5,4 A6.5,6.5 0 1,1 10.5,17 A6.5,6.5 0 1,1 10.5,4 Z M15.2,15.2 L20,20
  </StreamGeometry>

  <!-- Validation / statut opérationnel -->
  <StreamGeometry x:Key="IconCheck">
    M5,12.5 L10,17.5 L19,7
  </StreamGeometry>

  <!-- Actualiser -->
  <StreamGeometry x:Key="IconRefresh">
    M20,12 A8,8 0 1,1 17.3,6 M17.3,6 V10.4 M17.3,6 H12.9
  </StreamGeometry>

</ResourceDictionary>
